  "cards": [
    {
      "dot": "cyan",
      "title": "Reliable ingestion boundary",
      "items": [
        "MQTT decouples producers from consumers",
        "QoS 1 supports at-least-once delivery",
        "event_id enables downstream idempotency/deduplication"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data-quality contract",
      "items": [
        "Bronze preserves malformed payloads instead of dropping them",
        "Silver applies machine-type bounds, forward-fill where possible, and DQ flags",
        "Rejects remain separately traceable"
      ]
    },
    {
      "dot": "violet",
      "title": "Honest OEE scope",
      "items": [
        "Availability and Performance are currently computed",
        "Quality and Wastage are intentionally null because reject/scrap data is not present",
        "A full OEE percentage is therefore not fabricated"
      ]
    },
    {
      "dot": "amber",
      "title": "Current boundary",
      "items": [
        "The repository currently stops at Gold KPI output",
        "Dashboard/consumer integration is a downstream extension, not represented as an implemented service"
      ]
    }
  ]
